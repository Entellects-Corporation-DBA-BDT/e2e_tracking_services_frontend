<IfModule mod_env.c>
    SetEnv LEAVE_APPROVAL_TO "hr_ind@bedatatech.com"
    SetEnv LEAVE_APPROVER_NAME "HR India"
    SetEnv APP_URL "https://e2e.beedatatech.com"
</IfModule>

<IfModule mod_rewrite.c>

    RewriteEngine On

    RewriteCond %{HTTP:Authorization} ^(.*)
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%1]

    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteCond %{REQUEST_FILENAME} !-d

    RewriteRule ^(.*)$ index.php?route=$1 [QSA,L]

</IfModule>