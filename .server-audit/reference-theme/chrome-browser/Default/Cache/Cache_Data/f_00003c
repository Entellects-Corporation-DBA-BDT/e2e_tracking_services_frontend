html .reference-admin-attendance header .admin-attendance-icon{display:grid;place-items:center;width:44px;height:44px;flex:0 0 44px;padding:0;border-radius:13px;background:var(--app-surface-2);color:var(--theme-blue);font-size:20px}
html .reference-admin-attendance header small{display:block;margin-top:4px;font-size:11px;color:var(--app-muted);letter-spacing:0;text-transform:none}
html .reference-admin-attendance p{margin:14px 0 18px;color:var(--app-muted);font-size:12px;line-height:1.7;letter-spacing:0;text-transform:none;font-weight:400}
html .reference-admin-attendance>button{display:flex;width:100%;min-height:42px;align-items:center;justify-content:center;gap:9px;padding:10px 14px;border:0;border-radius:10px;background:var(--theme-gradient);color:#fff;font-family:inherit;font-size:12px;font-weight:700;cursor:pointer;transition:box-shadow .2s ease}
html .reference-admin-attendance>button:hover{box-shadow:0 6px 16px #087bff33}
html .reference-admin-attendance>button:focus-visible{outline:3px solid #087bff55;outline-offset:3px}
html .reference-admin-attendance>button span{margin-left:auto;color:#fff}

/* Attendance presence remains visible outside the clipped photo circle. */
.e2e_navbar_avatar_presence{position:relative;display:inline-flex;flex:0 0 auto;overflow:visible}
html .e2e_navbar_presence_dot{position:absolute;right:-1px;bottom:-1px;width:11px;height:11px;box-sizing:border-box;border:2px solid var(--app-surface,#fff);border-radius:50%;background:#94a3b8;box-shadow:0 1px 4px #10213b26;pointer-events:auto}
html .e2e_navbar_presence_dot.online{background:#16c784}
html .e2e_navbar_presence_dot.offline{background:#ef4444}
html .e2e_navbar_presence_dot.overdue{background:#f59e0b;animation:attendance-presence-pulse 1.6s ease-in-out infinite}
@keyframes attendance-presence-pulse{0%,100%{opacity:1;box-shadow:0 0 0 0 #f59e0b50}50%{opacity:.5;box-shadow:0 0 0 4px #f59e0b00}}
@media(prefers-reduced-motion:reduce){html .e2e_navbar_presence_dot.overdue{animation:none}}

.e2e_sidebar_brand_footer span{float:right;color:#bcc9e5;font-variant-numeric:tabular-nums;letter-spacing:0}

.reference-employee-id{display:inline-flex;align-items:center;gap:9px;margin-bottom:12px;padding:8px 13px;border:1px solid #087bff33;border-radius:11px;background:var(--app-surface);box-shadow:0 3px 12px #087bff0d}
html .reference-profile-hero .reference-employee-id>svg{font-size:21px;color:var(--theme-blue)}
html .reference-profile-hero .reference-employee-id span{font-size:9px;color:var(--app-muted);line-height:1.4;letter-spacing:.04em}
html .reference-profile-hero .reference-employee-id strong{display:block;font-size:15px;color:var(--app-text);letter-spacing:.035em}
